    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
