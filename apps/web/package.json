    "@supabase/supabase-js": "^2.46.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.447.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.12.0",
